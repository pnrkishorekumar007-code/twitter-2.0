# Twiller backend — copy to .env and fill in real values. NEVER commit .env.

# MongoDB Atlas (free M0 cluster) — add /twiller?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/twiller?retryWrites=true&w=majority

PORT=5000

# Gmail SMTP (free) — use a 16-char "App Password", not your normal password
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your16charapppassword

# Razorpay (free test mode keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Cloudinary (free tier) — for storing uploaded audio tweets
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase service account: paste the whole downloaded JSON as ONE line.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# If unset, forgot-password still shows a new password but won't update the real login.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
