# ──────────────────────────────────────────────────────────────
# Twiller 2.0 — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0

PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated).
# Set this to your deployed Vercel domain in production, e.g.:
#   FRONTEND_ORIGIN=https://twitter-2-0-twiller.vercel.app
# Defaults: http://localhost:3000, https://twitter-2-0-twiller.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,https://twitter-2-0-twiller.vercel.app

# ── Gmail SMTP (for OTP + transactional emails) ──────────────
# Do NOT use your normal Gmail password. Use a Gmail App Password.
# Generate one at: https://myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification (enable) → App Passwords → Generate
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop

# ── Brevo Transactional Email API (optional, recommended) ─────
# Free tier: 300 emails/day. Get your key at: https://app.brevo.com/settings/keys
# IMPORTANT: The key MUST start with "xkeysib-" (not "xsmtpsib-").
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxx
# BREVO_FROM_EMAIL=verified-sender@example.com
# BREVO_FROM_NAME=Twiller

# ── Razorpay (test mode keys from the Razorpay dashboard) ─────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ── Cloudinary (for audio tweet storage) ─────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Firebase (for payment auth tokens) ───────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Security ─────────────────────────────────────────────────
# REQUIRED — a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
LOGIN_OTP_SECRET=
LOGIN_OTP_TTL_MINUTES=5
AUDIO_OTP_SECRET=
LANGUAGE_OTP_SECRET=

# ── SMS OTP (multi-language support) ─────────────────────────
# Optional — when unset, phone OTPs are emailed as a dev fallback.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
SMS_PROVIDER_URL=
