MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/twiller?retryWrites=true&w=majority
# (also accepted: MONGODB_URI)

PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated). In production,
# set this to your deployed frontend, e.g. https://twitter-2-0-twiller.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,https://twitter-2-0-twiller.vercel.app

# Gmail SMTP (free) — use a 16-char "App Password", not your normal password
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your16charapppassword

# Razorpay (free test mode keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Cloudinary (free tier) — for storing uploaded audio tweets
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase service account — used to verify payment auth tokens (requires
# FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or the
# full FIREBASE_SERVICE_ACCOUNT JSON as one line).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional alternative to the three vars above:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Advanced login security (JWT sessions + hashed login OTPs)
# REQUIRED for production — a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional second secret used ONLY for hashing login OTPs. Defaults to JWT_SECRET.
LOGIN_OTP_SECRET=
# Login OTP lifetime in minutes (default 5)
LOGIN_OTP_TTL_MINUTES=5
# Optional secret used ONLY for hashing audio-tweet OTPs. Defaults to JWT_SECRET.
AUDIO_OTP_SECRET=

# Multi-language support — SMS OTP for non-French language switches.
# Optional on the free tier: when unset, "mobile" OTPs are emailed instead
# (dev fallback) so the flow still works end-to-end.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
# Optional generic webhook URL that accepts { to, text } with the API key as a
# Bearer token. If unset, plug a real provider into services/smsService.js.
SMS_PROVIDER_URL=
# Optional secret used ONLY for hashing language-change OTPs. Defaults to JWT_SECRET.
LANGUAGE_OTP_SECRET=
